        "fs_write": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "exec": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "network": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "credential": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "github": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "budget": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "rollback_boundary": {"type": "string"}
  },
  "additionalProperties": false
