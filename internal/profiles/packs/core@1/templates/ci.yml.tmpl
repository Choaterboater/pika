name: check
on:
  push:
    branches: [main]
    paths:
{{.CIPaths}}
  pull_request:
    paths:
{{.CIPaths}}
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{{.CISteps}}      - name: Install projectctl
        run: go install github.com/Choaterboater/projectctl/cmd/projectctl@latest
      - name: Verify
        run: projectctl check --ci
