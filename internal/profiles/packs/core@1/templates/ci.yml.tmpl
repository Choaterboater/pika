name: check
on:
  push:
    branches: [main]
    paths:
{{.CIPaths}}
  pull_request:
    paths:
{{.CIPaths}}
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{{.CISteps}}      - name: Install pika
        run: go install github.com/Choaterboater/pika/cmd/pika@latest
      - name: Verify
        run: pika check --ci
